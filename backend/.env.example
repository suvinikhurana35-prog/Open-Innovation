# ============================================================
#  JanNiti backend — environment configuration
#  Copy this file to  backend/.env  and fill in your real key.
#  NEVER commit the real .env to GitHub.
# ============================================================

# ---- LLM provider (Anthropic) ----
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

LLM_TIMEOUT=60
LLM_MAX_TOKENS=4096

# ---- RAG / data ----
# Leave DISABLE_RAG unset (or 0) locally so RAG runs — needed for evaluation.
# The deployed free-tier instance sets DISABLE_RAG=1 to fit in 512MB RAM.
# DISABLE_RAG=1
CHROMA_PERSIST_DIR=./data/chroma
EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
AUTO_INGEST_ON_START=true

# ---- research flags ----
ENABLE_FAITHFULNESS=true
ENABLE_SELECTIVE_RETRIEVAL=true

# ---- CORS (comma-separated; add your Vercel URL after deploying) ----
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
